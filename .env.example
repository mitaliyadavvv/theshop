# ---------------------------------------------------------------------------
# the shop. — environment variables
# Copy to .env.local for local development. In Vercel: Project → Settings →
# Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------

# Site name (purely cosmetic).
NEXT_PUBLIC_BRAND_NAME="the shop."

# Public site URL — used for auth email links. http://localhost:3100 locally,
# your production domain on Vercel (e.g. https://the-shop.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase → Project Settings → API (Data API). These two are PUBLIC by design:
# the publishable/anon key only grants what RLS policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" key

# SERVER ONLY — Supabase → Connect → "Transaction pooler" connection string (port 6543).
# Used by the server for ingestion and for running user queries under RLS.
# Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional, scripts only: the "Session pooler"/direct connection (port 5432) for
# running migrations. Falls back to DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# SERVER ONLY — protects /api/sync. Vercel Cron sends it automatically as a Bearer token.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# Sync behaviour
SYNC_INTERVAL_HOURS=24        # default per-source interval; failed sources retry hourly
NEW_DROP_DAYS=14              # window for the "New" label
SYNC_SCHEDULER=off            # "on" = in-process scheduler for a long-running local server (ignored on Vercel)
SYNC_TICK_MINUTES=15
DEMO_MODE=off                 # show clearly-labelled sample products (npm run demo:seed)
# SERVER/SCRIPTS ONLY — never add to Vercel or NEXT_PUBLIC_. Used by npm run e2e to create throwaway test users.
# SUPABASE_SERVICE_ROLE_KEY=
